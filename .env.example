# Sao chép thành .env (không commit) rồi điền giá trị thật.

# Xác thực
JWT_SECRET=
JWT_ACCESS_MS=900000
JWT_REFRESH_DAYS=7
# Mật khẩu cho tài khoản "admin" tạo lúc khởi động khi chưa có người dùng nào (8–72 byte). Để trống thì không tạo.
APP_ADMIN_PASSWORD=

# Nghiệp vụ
APP_TIMEZONE=Asia/Ho_Chi_Minh
RETURN_WINDOW_DAYS=7
APP_SEED_DEMO=false
# Mật khẩu cho thukho01, thungan01, thungan02 khi tạo dữ liệu demo (để trống thì dùng APP_ADMIN_PASSWORD)
APP_SEED_PASSWORD=
APP_SEED_ORDERS=80

# MongoDB: Atlas (mongodb+srv://...) hoặc cài máy. Cài máy phải là replica set để có transaction:
# chạy scripts/mongo-local-replset.ps1 một lần, dùng URI mongodb://127.0.0.1:27017/?directConnection=true và MONGODB_INIT_REPLSET=true
MONGODB_URI=
MONGODB_DATABASE=supermarket
MONGODB_INIT_REPLSET=false

# Cassandra: ASTRA (cloud) hoặc LOCAL
CASSANDRA_MODE=ASTRA
ASTRA_SECURE_BUNDLE=../secrets/secure-connect-supermarket-bigdata.zip
APPLICATION_TOKEN=
CASSANDRA_KEYSPACE=supermarket

# Neo4j: AuraDB (neo4j+s://...) hoặc docker compose (bolt://localhost:7687, mật khẩu ≥ 8 ký tự)
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Redis: Redis Cloud/Upstash (rediss://...) hoặc docker compose (redis://localhost:6379)
REDIS_URL=

# Cassandra local (CASSANDRA_MODE=LOCAL, docker compose --profile cassandra up -d)
CASSANDRA_HOST=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_DATACENTER=datacenter1

# Vận hành
SYNC_ENABLED=true
SCHEMA_INIT=true
