# Sao chép thành .env (không commit) rồi điền giá trị thật.

# Xác thực
JWT_SECRET=
JWT_ACCESS_MS=900000
JWT_REFRESH_DAYS=7

# Nghiệp vụ
APP_TIMEZONE=Asia/Ho_Chi_Minh
RETURN_WINDOW_DAYS=7
APP_SEED_DEMO=false

# MongoDB Atlas
MONGODB_URI=
MONGODB_DATABASE=supermarket

# Cassandra: ASTRA (cloud) hoặc LOCAL
CASSANDRA_MODE=ASTRA
ASTRA_SECURE_BUNDLE=../secrets/secure-connect-supermarket-bigdata.zip
APPLICATION_TOKEN=
CASSANDRA_KEYSPACE=supermarket

# Neo4j AuraDB
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Redis Cloud / Upstash (rediss://...)
REDIS_URL=
