# Sao chép thành .env (không commit) rồi điền giá trị thật.

# Xác thực
JWT_SECRET=
JWT_ACCESS_MS=900000
JWT_REFRESH_DAYS=7
# Mật khẩu cho tài khoản "admin" tạo lúc khởi động khi chưa có người dùng nào (8–72 byte). Để trống thì không tạo.
APP_ADMIN_PASSWORD=

# Nghiệp vụ
APP_TIMEZONE=Asia/Ho_Chi_Minh
RETURN_WINDOW_DAYS=7
APP_SEED_DEMO=false

# MongoDB Atlas (bắt buộc replica set: Atlas M0 đã là replica set; MongoDB cài máy dạng standalone không có transaction)
MONGODB_URI=
MONGODB_DATABASE=supermarket

# Cassandra: ASTRA (cloud) hoặc LOCAL
CASSANDRA_MODE=ASTRA
ASTRA_SECURE_BUNDLE=../secrets/secure-connect-supermarket-bigdata.zip
APPLICATION_TOKEN=
CASSANDRA_KEYSPACE=supermarket

# Neo4j AuraDB
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Redis Cloud / Upstash (rediss://...)
REDIS_URL=

# Cassandra local (chỉ dùng khi CASSANDRA_MODE=LOCAL)
CASSANDRA_HOST=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_DATACENTER=datacenter1

# Vận hành
SYNC_ENABLED=true
SCHEMA_INIT=true
